          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-mini",
          "cachedResultName": "gpt-4.1-mini"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "Sos un asistente clinico veterinario. Vas a recibir el texto de una anamnesis dictada por el veterinario durante una consulta (puede tener errores de dictado por voz y jerga abreviada: 'frr'/'fr' = frecuencia respiratoria, 'fc' = frecuencia cardiaca, 'pas/pam/pad' = presion arterial sistolica/media/diastolica). Tu tarea es extraer y estructurar SOLO la informacion que este explicita o claramente implicita en el texto, sin inventar datos. Si un dato no aparece, devolve null (o lista vacia para arrays). Los valores de frecuencia y presion deben ser numericos. El resumen_anamnesis debe ser 1-2 frases claras en espanol."
            },
            {
              "content": "=Especie: {{ $json.body.filiacion?.mascota?.especie || 'no especificada' }}\nDiagnostico ya registrado: {{ $json.body.consulta?.diagnostico || 'sin registrar' }}\n\nAnamnesis dictada por el veterinario:\n{{ $json.body.consulta?.anamnesis }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "borrador_medico_v4",
              "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"fc\": {\"type\": [\"number\", \"null\"]},\n    \"fr\": {\"type\": [\"number\", \"null\"]},\n    \"pas\": {\"type\": [\"number\", \"null\"]},\n    \"pam\": {\"type\": [\"number\", \"null\"]},\n    \"pad\": {\"type\": [\"number\", \"null\"]},\n    \"mucosas\": {\"type\": [\"string\", \"null\"]},\n    \"sintomas_detectados\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n    \"cumplimiento_tratamiento\": {\"type\": [\"string\", \"null\"]},\n    \"diagnostico_sugerido\": {\"type\": [\"string\", \"null\"]},\n    \"indicaciones_sugeridas\": {\"type\": [\"string\", \"null\"]},\n    \"resumen_anamnesis\": {\"type\": \"string\"}\n  },\n  \"required\": [\"fc\", \"fr\", \"pas\", \"pam\", \"pad\", \"mucosas\", \"sintomas_detectados\", \"cumplimiento_tratamiento\", \"diagnostico_sugerido\", \"indicaciones_sugeridas\", \"resumen_anamnesis\"],\n  \"additionalProperties\": false\n}",
              "strict": true
            }
          }
