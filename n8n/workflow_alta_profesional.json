    {
      "id": "9f1a2b3c-0001-4a2b-9c3d-000000000001",
      "name": "Webhook",
      "webhookId": "9f1a2b3c-0001-4a2b-9c3d-000000000099",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -400,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "alta-profesional",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      }
    },
    {
      "id": "9f1a2b3c-0002-4a2b-9c3d-000000000002",
      "name": "Validar payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "onError": "continueErrorOutput",
      "position": [
        -160,
        0
      ],
      "parameters": {
        "jsCode": "const body = $input.item.json.body || {};\nconst required = ['nombre', 'apellido', 'matricula', 'email', 'firma_url'];\nconst faltantes = required.filter((campo) => !body[campo] || String(body[campo]).trim() === '');\n\nif (faltantes.length > 0) {\n  throw new Error(`Faltan campos obligatorios: ${faltantes.join(', ')}`);\n}\n\nreturn {\n  json: {\n    nombre: String(body.nombre).trim(),\n    apellido: String(body.apellido).trim(),\n    matricula: String(body.matricula).trim(),\n    matricula_2: body.matricula_2 ? String(body.matricula_2).trim() : null,\n    email: String(body.email).trim().toLowerCase(),\n    telefono: body.telefono ? String(body.telefono).trim() : null,\n    especialidad: body.especialidad ? String(body.especialidad).trim() : null,\n    firma_url: String(body.firma_url).trim(),\n    activo: true\n  }\n};"
      }
    },
    {
      "id": "9f1a2b3c-0003-4a2b-9c3d-000000000003",
      "name": "Upsert Profesional",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://tuedigqvvkvgongpcnjx.supabase.co/rest/v1/profesionales?on_conflict=email",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "EPCExaKpytpqeH99",
          "name": "Supabase myvete-cardiologia (service_role, apikey header)"
        }
      }
    },
    {
      "id": "9f1a2b3c-0004-4a2b-9c3d-000000000004",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        320,
        -80
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: \"ok\", profesional_id: $json.id ?? ($json[0] ? $json[0].id : null), profesional: Array.isArray($json) ? $json[0] : $json } }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "9f1a2b3c-0005-4a2b-9c3d-000000000005",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        320,
        120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: \"error\", message: $json.error?.message ?? $json.message ?? \"Error al validar o guardar el profesional\" } }}",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],
